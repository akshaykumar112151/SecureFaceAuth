{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python311", "gcc", "libGL", "libGLU", "mesa", "mesa_drivers"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn app:app --bind 0.0.0.0:$PORT --workers 1 --timeout 300",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}